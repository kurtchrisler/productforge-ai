# Copy this file to .env.local and fill in your own values.

# Optional: without this set, ProductForge AI generates deterministic demo
# content so you can try the whole flow with no API key at all.
OPENAI_API_KEY=

# Optional: defaults to gpt-4o-mini. Set to whatever chat-completions model
# your OpenAI account has access to.
OPENAI_MODEL=gpt-4o-mini
