# Copy this file to .env.local (or .env on the server) and fill in your own values.

# Required: used to encrypt customers' own OpenAI API keys at rest in the
# database. Generate one with: openssl rand -hex 32
# Changing this after customers have saved keys will make existing saved
# keys undecryptable (they'll need to re-enter them), so set it once and
# keep it stable.
ENCRYPTION_KEY=

# Optional: defaults to gpt-4o-mini. Applies to every customer's generation
# request, but each request is still billed to that customer's own OpenAI
# key (added in-app under Settings) — not to any key set here.
OPENAI_MODEL=gpt-4o-mini
